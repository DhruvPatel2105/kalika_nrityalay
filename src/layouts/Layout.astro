---
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { localBusinessSchema } from "@/lib/schema";

interface Props {
  title: string;
  description: string;
  /** Shorter, WhatsApp-safe variants — brief section 9: og:title <60
   * chars, og:description <110. Falls back to title/description. */
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  /** Additional JSON-LD objects for this page, beyond the sitewide
   * LocalBusiness schema every page already carries. */
  schema?: unknown[];
  /** Blog posts set "article" plus their dates. */
  ogType?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Text-first pages paint before the web fonts arrive, then reflow
   * when they swap in (measured CLS 0.135 on a blog post). Preloading
   * fixes that; photo-led pages skip it so the fonts don't compete with
   * their LCP image. */
  preloadFonts?: boolean;
}

const {
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  ogImage = "/og/default.png",
  schema = [],
  ogType = "website",
  publishedTime,
  modifiedTime,
  preloadFonts = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
const allSchema = [localBusinessSchema(), ...schema];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      preloadFonts && (
        <>
          <link
            rel="preload"
            href="/fonts/marcellus-latin-400.woff2"
            as="font"
            type="font/woff2"
            crossorigin
          />
          <link
            rel="preload"
            href="/fonts/karla-latin-variable.woff2"
            as="font"
            type="font/woff2"
            crossorigin
          />
        </>
      )
    }
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content={ogType} />
    {
      publishedTime && (
        <meta
          property="article:published_time"
          content={publishedTime.toISOString()}
        />
      )
    }
    {
      modifiedTime && (
        <meta
          property="article:modified_time"
          content={modifiedTime.toISOString()}
        />
      )
    }
    <meta property="og:site_name" content="Kalika Nrityalay" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImageURL} />

    {
      allSchema.map((item) => (
        <script type="application/ld+json" set:html={JSON.stringify(item)} is:inline />
      ))
    }
  </head>
  <body class="bg-sandalwood font-body text-ink">
    <Header />
    <slot />
    <Footer />
  </body>
</html>
