---
/**
 * Single-purpose conversion page — brief section 6: "No navigation
 * distractions." A trimmed header/footer, wordmark and contact only,
 * no page nav list.
 */
import "@/styles/global.css";
import { Image } from "astro:assets";
import { site } from "@/content/site";
import logoEmblem from "@/images/logo-emblem-oxblood.png";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
}
const {
  title,
  description,
  ogImage = "/og/default.png",
  noindex = false,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kalika Nrityalay" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageURL} />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body class="bg-sandalwood font-body text-ink">
    <header class="bg-sandalwood px-4 py-4 sm:px-6">
      <a href="/" class="flex min-h-11 items-center gap-2.5 py-2">
        <Image
          src={logoEmblem}
          alt=""
          width={76}
          height={36}
          class="h-[18px] w-auto"
        />
        <span class="font-display text-xl text-oxblood">{site.name}</span>
      </a>
    </header>

    <slot />

    <footer class="on-oxblood bg-oxblood-deep px-4 py-8 text-center sm:px-6">
      <p class="text-sm text-sandalwood/70">
        &copy; {new Date().getFullYear()} {site.name}
      </p>
    </footer>
  </body>
</html>
