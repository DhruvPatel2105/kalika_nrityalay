---
import Layout from "@/layouts/Layout.astro";
import { site } from "@/content/site";
---

<Layout
  title={`${site.name} — Learn Bharatanatyam from Ahmedabad`}
  description="Live weekend classes for children in the USA and Canada, taught by a Master's-qualified guru in the Pandanallur tradition."
>
  <main class="min-h-screen bg-oxblood on-oxblood p-8">
    <h1 class="font-display text-5xl">{site.name}</h1>
    <p class="text-base measure mt-4">Scaffold check — tokens, fonts, and content layer are wired up.</p>
  </main>
</Layout>
