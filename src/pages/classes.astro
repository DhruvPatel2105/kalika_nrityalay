---
import Layout from "@/layouts/Layout.astro";
import PageIntro from "@/components/PageIntro.astro";
import SiteImage from "@/components/SiteImage.astro";
import FAQAccordion from "@/components/FAQAccordion.astro";
import TrialCTA from "@/components/TrialCTA.astro";
import { site } from "@/content/site";
import { coursesSchema, faqPageSchema } from "@/lib/schema";

const classesSchema = [...coursesSchema(), faqPageSchema("classes")].filter(
  Boolean,
);
---

<Layout
  title={`Online Bharatanatyam Classes for Kids, USA & Canada — ${site.name}`}
  description="Live weekend Bharatanatyam classes for children in the USA and Canada, small batches, recorded on Zoom for makeup."
  ogTitle="Online Classes — USA & Canada"
  ogDescription="Live weekend Bharatanatyam classes, small batches of 6-8, recorded on Zoom for makeup."
  schema={classesSchema}
>
  <main>
    <PageIntro
      title="Online, for the USA & Canada"
      intro={`Batches of ${site.capacity.minStudentsPerBatch}–${site.capacity.maxStudentsPerBatch}, taught live by Binni herself.`}
    />

    <section class="bg-sandalwood px-4 pb-16 sm:px-6">
      <div class="mx-auto max-w-2xl">
        <h2 class="font-display text-2xl text-oxblood">
          What a class looks like
        </h2>
        <p class="mt-4 text-lg text-ink">
          Classes run live on Zoom, twice a week, in small batches of{" "}
          {site.capacity.minStudentsPerBatch}–{
            site.capacity.maxStudentsPerBatch
          }{" "}
          students. Every session is recorded, so a missed class can be
          caught up.
        </p>
        <h2 class="mt-8 font-display text-2xl text-oxblood">
          What you'll need at home
        </h2>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-lg text-ink">
          <li>A clear floor space, about 2m by 2m</li>
          <li>A laptop or tablet</li>
          <li>No mirror required</li>
        </ul>
      </div>
    </section>

    <section class="bg-sandalwood px-4 pb-16 sm:px-6">
      <div class="mx-auto max-w-3xl">
        <div class="border border-gold/60">
          <SiteImage
            id="students-namaskaram"
            class="aspect-[1600/826]"
            sizes="(min-width: 768px) 768px, 100vw"
          />
        </div>
        <p class="mt-3 text-center text-sm text-ink/70">
          Students at the Vastral studio, with Binni.
        </p>
      </div>
    </section>

    <section class="bg-peacock px-4 py-14 sm:px-6 sm:py-20">
      <div class="mx-auto max-w-2xl text-sandalwood">
        <h2 class="font-display text-2xl">A note on safety</h2>
        <p class="mt-4 text-lg">
          Classes are recorded. A parent is welcome in the room at any time.
          Binni communicates with parents, never directly with students
          under 18.
        </p>
      </div>
    </section>

    <FAQAccordion page="classes" />

    <TrialCTA />
  </main>
</Layout>
