---
import TrialLayout from "@/layouts/TrialLayout.astro";
import WhatsAppLink from "@/components/WhatsAppLink.astro";
import Button from "@/components/Button.astro";
import { site } from "@/content/site";

const whatsappMessage = `Hi Binni, I just requested my daughter's free classes on the website.`;
---

<TrialLayout
  title={`Request received — ${site.name}`}
  description="Your request for two free classes has been received. Binni will reply on WhatsApp within 24 hours."
  noindex
>
  <main class="px-4 py-16 text-center sm:px-6 sm:py-24">
    <div class="mx-auto max-w-lg">
      <h1 class="font-display text-3xl text-oxblood sm:text-4xl">
        Thank you — we've got your request.
      </h1>
      <p class="measure mx-auto mt-4 text-lg text-ink/80">
        Binni will reply on WhatsApp within 24 hours to confirm a time
        around your preference. If you'd rather not wait, message her
        directly and mention that you just filled in the form.
      </p>

      <div class="mt-8 flex flex-col items-center gap-3">
        <WhatsAppLink message={whatsappMessage}>
          <span
            class="inline-flex items-center justify-center bg-peacock px-6 py-3 font-body text-base font-medium text-sandalwood hover:bg-peacock-light"
          >
            Message Binni on WhatsApp
          </span>
        </WhatsAppLink>
        <Button href="/" variant="peacock-outline-light">Back to the home page</Button>
      </div>
    </div>
  </main>
</TrialLayout>
