---
import Layout from "@/layouts/Layout.astro";
import PageIntro from "@/components/PageIntro.astro";
import CurriculumLevel from "@/components/CurriculumLevel.astro";
import SiteImage from "@/components/SiteImage.astro";
import AramandiDivider from "@/components/AramandiDivider.astro";
import TrialCTA from "@/components/TrialCTA.astro";
import { site } from "@/content/site";
import { yearOne } from "@/content/curriculum";
---

<Layout
  title={`Bharatanatyam Curriculum for Kids — ${site.name}`}
  description="The graded Bharatanatyam path at Kalika Nrityalay, starting with aramandi, the first adavus, hastas, and basic theory."
  ogTitle="The Graded Bharatanatyam Path"
  ogDescription="Year one: aramandi, the first adavus, hastas, and basic theory — the foundation everything else builds on."
>
  <main>
    <PageIntro
      title="The graded path"
      intro="Bharatanatyam is taught through a graded examination system — Prarambhik, Praveshika, Madhyama, and Visharad, followed by Alankar. It typically takes years to move through. Here is where every student begins."
      motif
    />

    <section class="bg-sandalwood px-4 pb-14 sm:px-6">
      <div class="mx-auto max-w-3xl">
        <SiteImage
          id="aramandi-row"
          class="aspect-[1600/688] w-full"
          priority
          sizes="(min-width: 768px) 768px, 100vw"
        />
        <p class="mt-3 text-center text-sm text-ink/70">
          Six students in true aramandi — turned-out, symmetric, grounded.
          This is the technique proof.
        </p>
      </div>
    </section>

    <AramandiDivider />

    <section class="bg-sandalwood px-4 py-16 sm:px-6">
      <div class="mx-auto max-w-2xl">
        <h2 class="font-display text-2xl text-oxblood">Year one</h2>
        <ul class="mt-4">
          {
            yearOne.map((level, i) => (
              <CurriculumLevel index={i + 1} title={level.title}>
                {level.body}
              </CurriculumLevel>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="bg-sandalwood px-4 pb-16 sm:px-6">
      <div class="mx-auto grid max-w-2xl grid-cols-2 gap-4">
        <div>
          <div class="aspect-square">
            <SiteImage
              id="hasta-detail"
              fit="contain"
              sizes="(min-width: 672px) 328px, calc(50vw - 24px)"
            />
          </div>
          <p class="mt-2 text-center text-sm text-ink/70">Tripataka mudra</p>
        </div>
        <div>
          <div class="aspect-square">
            <SiteImage
              id="feet-adavu"
              fit="contain"
              sizes="(min-width: 672px) 328px, calc(50vw - 24px)"
            />
          </div>
          <p class="mt-2 text-center text-sm text-ink/70">
            Salangai
          </p>
        </div>
      </div>
      <p class="measure mx-auto mt-12 max-w-2xl text-base text-ink/80">
        How the levels fit together, and how exams differ from an
        arangetram:{" "}
        <a href="/blog/bharatanatyam-exams-prarambhik-to-alankar" class="link-kn"
          >Bharatanatyam exams explained</a
        >. Or read about{" "}
        <a href="/benefits-of-bharatanatyam" class="link-kn"
          >what children gain from Bharatanatyam</a
        >.
      </p>
    </section>

    <TrialCTA
      heading="Start at the foundation."
      body="Your first two classes are free — come see how Year One begins."
    />
  </main>
</Layout>
