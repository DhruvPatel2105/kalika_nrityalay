---
/**
 * Resolves one images.ts slot: a real, optimized <Image> once
 * `status` is "final", otherwise the labelled placeholder box at the
 * same aspect ratio. Never a stock photo, never AI-generated — see
 * BRIEF.md sections 2 & 8.
 */
import { Image } from "astro:assets";
import { getImage } from "@/content/images";
import { resolveImageAsset } from "@/lib/imageAssets";

interface Props {
  id: string;
  class?: string;
  /** Above-the-fold images (near the top of a page) should load
   * eagerly — lazy-loading them delays the LCP paint instead of
   * saving anything, since the browser has to discover them are
   * needed before fetching. Defaults to lazy, which is correct for
   * everything below the first viewport. */
  priority?: boolean;
  /** CSS `sizes` for the image's actual rendered width at each
   * breakpoint (e.g. "(min-width: 768px) 768px, 100vw"). Without
   * this, Astro ships one full-resolution file regardless of display
   * size — measured as 80%+ wasted bytes on the photos in this site,
   * enough to blow the LCP budget on its own. */
  sizes?: string;
}

const { id, class: className = "", priority = false, sizes } = Astro.props;
const slot = getImage(id);
const asset =
  slot.status === "final" && slot.path ? resolveImageAsset(slot.path) : null;

const CANDIDATE_WIDTHS = [400, 640, 800, 1000, 1200, 1600];
const widths =
  asset && sizes
    ? [...new Set([...CANDIDATE_WIDTHS.filter((w) => w < asset.width), asset.width])]
    : undefined;
---

{
  asset ? (
    <Image
      src={asset}
      alt={slot.alt}
      class={`h-full w-full object-cover ${className}`}
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : "auto"}
      widths={widths}
      sizes={sizes}
    />
  ) : (
    <div
      class={`flex h-full w-full flex-col items-center justify-center gap-1 bg-[repeating-linear-gradient(135deg,var(--color-oxblood-deep),var(--color-oxblood-deep)_10px,var(--color-oxblood)_10px,var(--color-oxblood)_20px)] px-4 text-center ${className}`}
      role="img"
      aria-label={slot.alt}
    >
      <span class="font-body text-xs tracking-wide text-gold-light/80 uppercase">
        Placeholder
      </span>
      <span class="font-body text-sm text-sandalwood">{slot.id}</span>
      <span class="font-body text-xs text-sandalwood/70">
        {slot.aspectRatio} · {slot.width}×{slot.height}
      </span>
    </div>
  )
}
