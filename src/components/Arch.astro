---
/**
 * The torana frame — brief section 4. Clips its slot content to a
 * pointed temple-arch silhouette and traces the same shape with a gold
 * hairline. Path is authored in objectBoundingBox units (0–1) so it
 * scales to any container size/aspect ratio without recomputation.
 */
import { ARCH_PATH, archPathLength } from "@/lib/geometry";

interface Props {
  id: string;
  /** Omit to let height follow content (used for the hero's full arch). */
  aspectRatio?: string;
  class?: string;
  /** Stroke draws on load instead of appearing static — hero only,
   * part of the one orchestrated entrance (brief section 5). */
  animate?: boolean;
}

const { id, aspectRatio, class: className = "", animate = false } = Astro.props;
const clipId = `arch-clip-${id}`;
const aspectStyle = aspectRatio ? `aspect-ratio: ${aspectRatio}` : "";
// With a fixed aspect ratio the parent already has a definite height, so
// the clipped wrapper can be laid out absolutely. Without one (the
// hero's content-sized arch), the wrapper must stay in normal flow —
// an absolutely positioned child can't establish its parent's height.
const wrapperPosition = aspectRatio ? "absolute inset-0" : "relative";
const pathLength = animate ? archPathLength() : 0;
---

<div class={`relative ${className}`} style={aspectStyle}>
  <svg width="0" height="0" class="absolute" aria-hidden="true">
    <defs>
      <clipPath id={clipId} clipPathUnits="objectBoundingBox">
        <path d={ARCH_PATH}></path>
      </clipPath>
    </defs>
  </svg>
  <div class={wrapperPosition} style={`clip-path: url(#${clipId})`}>
    <slot />
  </div>
  <svg
    class="pointer-events-none absolute inset-0 h-full w-full"
    viewBox="0 0 1 1"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path
      d={ARCH_PATH}
      fill="none"
      stroke="var(--color-gold)"
      stroke-width="0.008"
      class={animate ? "arch-stroke-draw" : ""}
      style={animate ? `stroke-dasharray: ${pathLength}; --arch-length: ${pathLength};` : ""}
    ></path>
  </svg>
</div>

{
  animate && (
    <style>
      .arch-stroke-draw {
        stroke-dashoffset: 0;
      }
      @media (prefers-reduced-motion: no-preference) {
        .arch-stroke-draw {
          animation: arch-draw 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
        @keyframes arch-draw {
          from {
            stroke-dashoffset: var(--arch-length);
          }
          to {
            stroke-dashoffset: 0;
          }
        }
      }
    </style>
  )
}
