---
import { Image } from "astro:assets";
import { site } from "@/content/site";
import { streetLines } from "@/lib/address";
import logoEmblem from "@/images/logo-emblem-white.png";

const links = [
  { href: "/guru", label: "Our Guru" },
  { href: "/classes", label: "Classes" },
  { href: "/curriculum", label: "Curriculum" },
  { href: "/fees", label: "Fees" },
  { href: "/trial", label: "Book your free classes" },
];

const learnLinks = [
  {
    href: "/bharatanatyam-classes-vastral-ahmedabad",
    label: `Classes in ${site.location.area}, ${site.location.city}`,
  },
  { href: "/benefits-of-bharatanatyam", label: "Benefits of Bharatanatyam" },
  { href: "/blog", label: "Guides for parents" },
];

const whatsappHref = `https://wa.me/${site.contact.whatsapp.digitsOnly}`;
---

<footer class="on-oxblood bg-oxblood-deep">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <Image
          src={logoEmblem}
          alt={site.name}
          width={220}
          height={104}
          class="h-[52px] w-auto"
        />
        <address class="mt-3 text-base not-italic text-sandalwood/80">
          {streetLines.map((line) => <span class="block">{line}</span>)}
          <span class="block">
            {site.location.city}, {site.location.state}
            {site.location.postalCode}
          </span>
        </address>
        <p class="mt-3 text-base text-sandalwood/80">
          Founded {site.founded.month} {site.founded.year}
        </p>
      </div>

      <nav aria-label="Footer">
        <ul>
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-block px-1.5 py-2.5 text-base text-sandalwood/90 hover:text-gold-light"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Learn more">
        <ul>
          {
            learnLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-block px-1.5 py-2.5 text-base text-sandalwood/90 hover:text-gold-light"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <p class="text-base text-sandalwood/90">
          <a
            href={whatsappHref}
            class="inline-block py-2.5 hover:text-gold-light"
            >WhatsApp: {site.contact.whatsapp.display}</a
          >
        </p>
        <p class="text-base text-sandalwood/90">
          <a
            href={site.contact.instagram}
            class="inline-block py-2.5 hover:text-gold-light"
            rel="noopener noreferrer">Instagram</a
          >
        </p>
      </div>
    </div>

    <p class="mt-10 border-t border-sandalwood/10 pt-6 text-sm text-sandalwood/60">
      &copy; {new Date().getFullYear()} {site.name}. All rights reserved.
    </p>
  </div>
</footer>
