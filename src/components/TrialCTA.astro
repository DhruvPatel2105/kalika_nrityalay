---
import Button from "@/components/Button.astro";

interface Props {
  heading?: string;
  body?: string;
}
const {
  heading = "See if it's the right fit.",
  body = "The first trial class is free, with no registration fee.",
} = Astro.props;
---

<section class="on-oxblood relative overflow-hidden bg-oxblood px-4 py-14 text-center sm:px-6 sm:py-20">
  <div class="relative z-10 mx-auto max-w-xl">
    <h2 class="font-display text-3xl sm:text-4xl">{heading}</h2>
    <p class="mt-3 text-base text-sandalwood/90">{body}</p>
    <div class="mt-8 flex justify-center">
      <Button href="/trial" variant="gold">Book a free trial class</Button>
    </div>
  </div>
</section>
