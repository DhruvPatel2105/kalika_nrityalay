---
import Button from "@/components/Button.astro";

interface Props {
  heading?: string;
  body?: string;
}
const {
  heading = "See if it's the right fit.",
  body = "Your first two classes are free, with no registration fee.",
} = Astro.props;

// The torana again, open at the foot — the same silhouette as the hero
// arch (lib/geometry.ts) without its closing base line, so the page
// ends inside the frame it began in. Drawn on scroll; see global.css.
const OPEN_ARCH = "M0 1 L0 0.4 C0 0.18 0.15 0.02 0.5 0.02 C0.85 0.02 1 0.18 1 0.4 L1 1";
---

<section
  class="on-oxblood relative overflow-hidden bg-oxblood px-4 pt-14 text-center sm:px-6 sm:pt-20"
  data-sticky-quiet
>
  <div class="relative z-10 mx-auto max-w-xl px-6 pt-16 pb-14 sm:px-10 sm:pt-24 sm:pb-20" data-reveal="arch">
    <svg
      class="pointer-events-none absolute inset-0 h-full w-full"
      viewBox="0 0 1 1"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <path
        d={OPEN_ARCH}
        pathLength="1"
        fill="none"
        stroke="var(--color-gold)"
        stroke-width="0.005"
        class="kn-arch-draw"></path>
    </svg>
    <div class="kn-arch-content relative">
      <h2 class="font-display text-3xl sm:text-4xl">{heading}</h2>
      <p class="mt-3 text-base text-sandalwood/90">{body}</p>
      <div class="mt-8 flex justify-center">
        <Button href="/trial" variant="gold">Book your free classes</Button>
      </div>
    </div>
  </div>
</section>
