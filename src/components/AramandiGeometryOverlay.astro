---
/**
 * The aramandi geometry overlay — brief section 4, "the one bold
 * moment." Thin gold lines tracing the geometry aramandi creates: the
 * shoulder horizontal, the diamond of the arms in natyarambhe, and the
 * triangle of the turned-out thighs.
 *
 * TODO(post-shoot): these coordinates are an illustrative placeholder
 * at the hero photo's 4:5 aspect ratio, NOT traced against a real
 * photograph — there isn't one yet (brief section 8). Once the hero
 * shot exists, re-author every point below against Binni's actual
 * posture in that image.
 *
 * Pure CSS stroke-dasharray/dashoffset draw, no JS. Segment lengths
 * are computed here at build time so each path draws at an accurate,
 * consistent rate.
 */
function dist(a: [number, number], b: [number, number]) {
  return Math.hypot(a[0] - b[0], a[1] - b[1]);
}
function pathLength(points: [number, number][]) {
  let total = 0;
  for (let i = 1; i < points.length; i++) total += dist(points[i - 1], points[i]);
  return total;
}
function toPath(points: [number, number][]) {
  return points.map((p, i) => `${i === 0 ? "M" : "L"}${p[0]} ${p[1]}`).join(" ");
}

const shoulders: [number, number][] = [
  [120, 150],
  [280, 150],
];
const armsDiamond: [number, number][] = [
  [200, 150],
  [108, 232],
  [200, 285],
  [292, 232],
  [200, 150],
];
const thighTriangle: [number, number][] = [
  [200, 305],
  [108, 432],
  [292, 432],
  [200, 305],
];

const lines = [shoulders, armsDiamond, thighTriangle].map((points) => ({
  d: toPath(points),
  length: Math.ceil(pathLength(points)),
}));
---

<div class="geometry-overlay pointer-events-none absolute inset-0">
  <svg viewBox="0 0 400 500" class="h-full w-full" aria-hidden="true">
    {
      lines.map((line) => (
        <path
          d={line.d}
          fill="none"
          stroke="var(--color-gold)"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="geometry-line"
          style={`stroke-dasharray: ${line.length}; --line-length: ${line.length};`}
        />
      ))
    }
  </svg>
  <p
    class="geometry-caption absolute right-3 bottom-3 left-3 text-center font-display text-sm text-gold-light italic opacity-0"
  >
    Pandanallur bani — geometry you can see.
  </p>
</div>

<style>
  .geometry-line {
    stroke-dashoffset: 0;
    opacity: 0.4;
  }
  .geometry-caption {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .geometry-line {
      animation: draw-line 1.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      animation-delay: 1.1s;
    }
    .geometry-caption {
      animation: fade-in 0.6s ease-out forwards;
      animation-delay: 3s;
    }
    @keyframes draw-line {
      from {
        stroke-dashoffset: var(--line-length);
        opacity: 1;
      }
      to {
        stroke-dashoffset: 0;
        opacity: 0.4;
      }
    }
    @keyframes fade-in {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }
  }
</style>
