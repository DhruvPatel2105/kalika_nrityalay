---
/**
 * Labelled stand-in for a real photo, at the exact final aspect ratio.
 * Never a stock photo, never AI-generated — see BRIEF.md sections 2 & 8.
 * Carries the real alt text now via role="img" so screen readers get
 * the same description a finished <Image> would provide later.
 */
import { getImage } from "@/content/images";

interface Props {
  id: string;
  class?: string;
}

const { id, class: className = "" } = Astro.props;
const img = getImage(id);
---

<div
  class={`flex h-full w-full flex-col items-center justify-center gap-1 bg-[repeating-linear-gradient(135deg,var(--color-oxblood-deep),var(--color-oxblood-deep)_10px,var(--color-oxblood)_10px,var(--color-oxblood)_20px)] px-4 text-center ${className}`}
  role="img"
  aria-label={img.alt}
>
  <span class="font-body text-xs tracking-wide text-gold-light/80 uppercase"
    >Placeholder</span
  >
  <span class="font-body text-sm text-sandalwood">{img.id}</span>
  <span class="font-body text-xs text-sandalwood/70"
    >{img.aspectRatio} · {img.width}×{img.height}</span
  >
</div>
