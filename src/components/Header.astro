---
import { Image } from "astro:assets";
import { site } from "@/content/site";
import logoEmblem from "@/images/logo-emblem-oxblood.png";

const navLinks = [
  { href: "/guru", label: "Our Guru" },
  { href: "/classes", label: "Classes" },
  { href: "/curriculum", label: "Curriculum" },
  { href: "/fees", label: "Fees" },
];
---

<header class="relative z-20 bg-sandalwood">
  <div
    class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6"
  >
    <a href="/" class="flex items-center gap-2.5">
      <Image
        src={logoEmblem}
        alt=""
        width={76}
        height={36}
        class="h-[18px] w-auto"
      />
      <span class="font-display text-xl text-oxblood">{site.name}</span>
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Primary">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="font-body text-base text-ink transition-colors hover:text-oxblood"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="/trial"
        class="bg-oxblood px-5 py-2.5 font-body text-base font-medium text-sandalwood transition-colors hover:bg-oxblood-deep"
        >Book your free classes</a
      >
    </nav>

    <button
      id="nav-toggle"
      type="button"
      class="flex h-11 w-11 items-center justify-center md:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav-panel"
    >
      <span class="sr-only">Open menu</span>
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M3 6h18M3 12h18M3 18h18"
          stroke="var(--color-oxblood)"
          stroke-width="2"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <nav
    id="mobile-nav-panel"
    hidden
    aria-label="Primary"
    class="border-t border-oxblood/10 bg-sandalwood md:hidden"
  >
    <ul class="flex flex-col px-4 py-2">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="block py-3 font-body text-lg text-ink"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="py-3">
        <a
          href="/trial"
          class="block bg-oxblood px-5 py-3 text-center font-body text-base font-medium text-sandalwood"
          >Book your free classes</a
        >
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const panel = document.getElementById("mobile-nav-panel");

  if (toggle && panel) {
    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!isOpen));
      panel.hidden = isOpen;
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !panel.hidden) {
        panel.hidden = true;
        toggle.setAttribute("aria-expanded", "false");
        toggle.focus();
      }
    });
  }
</script>
